% zosmac.latex — custom pandoc template
% Place at: ~/.pandoc/templates/zosmac.latex
% Use with: (setq org-pandoc-options-for-latex-pdf '((pdf-engine . "xelatex") (template . "zosmac")))

\documentclass[11pt, a4paper]{article}

%% ── Fonts ──────────────────────────────────────────────────────────────────
\usepackage{fontspec}
\setmainfont{Latin Modern Roman}
\setmonofont{Latin Modern Mono}[Scale=0.88]

%% ── Page geometry ───────────────────────────────────────────────────────────
\usepackage[
  top=2.8cm, bottom=2.8cm,
  left=3cm,  right=3cm,
  headheight=16pt
]{geometry}

%% ── Colors ──────────────────────────────────────────────────────────────────
\usepackage{xcolor}
\definecolor{accent}   {HTML}{2E4057}   % dark slate blue
\definecolor{rulecolor}{HTML}{C8D0DA}   % soft gray rule
\definecolor{added}    {HTML}{2D6A2D}   % diff green
\definecolor{removed}  {HTML}{A03030}   % diff red
\definecolor{codebg}   {HTML}{F5F6F8}   % code background
\definecolor{keyword}  {HTML}{2255AA}   % keyword blue
\definecolor{comment}  {HTML}{5A7A5A}   % comment green
\definecolor{string}   {HTML}{AA3333}   % string red
\definecolor{todocolor}{HTML}{C05000}   % org TODO orange
\definecolor{donecolor}{HTML}{2D6A2D}   % org DONE green

%% ── Core packages ───────────────────────────────────────────────────────────
\usepackage{parskip}
\usepackage[expansion=false, protrusion=true]{microtype}
\usepackage{graphicx}
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{amsmath}
\usepackage{amssymb}
\usepackage{enumitem}
\usepackage{soul}         % \hl highlighting

%% ── Hyperref ────────────────────────────────────────────────────────────────
\usepackage[
  colorlinks=true,
  linkcolor=accent,
  urlcolor=accent,
  citecolor=accent,
  pdfusetitle
]{hyperref}

%% ── Section styling ─────────────────────────────────────────────────────────
\usepackage{titlesec}
\titleformat{\section}
  {\large\bfseries\color{accent}}
  {\thesection}{1em}{}
  [\vspace{2pt}{\color{rulecolor}\titlerule[0.6pt]}]

\titleformat{\subsection}
  {\normalsize\bfseries\color{accent}}
  {\thesubsection}{1em}{}

\titleformat{\subsubsection}
  {\normalsize\itshape}
  {\thesubsubsection}{1em}{}

\titlespacing{\section}      {0pt}{1.8ex plus .5ex}{0.8ex}
\titlespacing{\subsection}   {0pt}{1.4ex plus .3ex}{0.4ex}
\titlespacing{\subsubsection}{0pt}{1.2ex plus .3ex}{0.2ex}

%% ── Header / Footer ─────────────────────────────────────────────────────────
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{rulecolor}\leaders\hrule height \headrulewidth\hfill}}
\fancyhead[L]{\small\color{accent}\textit{$if(title)$$title$$endif$}}
\fancyhead[R]{\small\color{accent}\thepage}
\renewcommand{\sectionmark}[1]{\markboth{#1}{}}

%% ── Code blocks (listings) ──────────────────────────────────────────────────
\usepackage{listings}

\lstdefinelanguage{diff}{
  morecomment=[f][\color{added}\bfseries]+,
  morecomment=[f][\color{removed}]-,
  morecomment=[f][\color{gray!70}]{@@},
  morecomment=[f][\color{gray!50}]{---},
  morecomment=[f][\color{gray!50}]{+++},
}

\lstset{
  basicstyle   = \ttfamily\small,
  keywordstyle = \color{keyword}\bfseries,
  commentstyle = \color{comment}\itshape,
  stringstyle  = \color{string},
  backgroundcolor = \color{codebg},
  frame        = single,
  framesep     = 4pt,
  rulecolor    = \color{rulecolor},
  numbers      = left,
  numberstyle  = \tiny\color{gray!70},
  numbersep    = 8pt,
  breaklines   = true,
  breakatwhitespace = true,
  columns      = fixed,
  keepspaces   = true,
  tabsize      = 4,
  xleftmargin  = 14pt,
  framexleftmargin = 14pt,
  aboveskip    = 1em,
  belowskip    = 1em,
}

%% ── Title block ─────────────────────────────────────────────────────────────
\usepackage{titling}
\pretitle{\begin{flushleft}\LARGE\bfseries\color{accent}}
\posttitle{\par\end{flushleft}\vspace{-0.5em}
           {\color{rulecolor}\rule{\linewidth}{1.2pt}}\vspace{0.4em}}
\preauthor{\begin{flushleft}\normalsize\color{gray!70}}
\postauthor{\end{flushleft}\vspace{-1.2em}}
\predate{\begin{flushleft}\small\color{gray!70}}
\postdate{\end{flushleft}\vspace{0.5em}}

%% ── Table of contents ───────────────────────────────────────────────────────
\usepackage{tocloft}
\renewcommand{\cftsecfont}{\bfseries\color{accent}}
\renewcommand{\cftsecpagefont}{\bfseries\color{accent}}
\renewcommand{\cftsubsecfont}{\color{accent}}
\setlength{\cftbeforesecskip}{4pt}

%% ── Org TODO keywords ───────────────────────────────────────────────────────
%% Pandoc passes these as plain text so we intercept via luatex if needed.
%% For now just ensure \textbf works without sffamily.
\newcommand{\orgtodo}[1]{\textbf{\textcolor{todocolor}{#1}}}
\newcommand{\orgdone}[1]{\textbf{\textcolor{donecolor}{#1}}}

%% ── Pandoc compatibility shims ──────────────────────────────────────────────
\usepackage{calc}
\newcommand{\passthrough}[1]{#1}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{2pt}\setlength{\parskip}{0pt}}

$if(highlighting-macros)$
$highlighting-macros$
$endif$

%% ────────────────────────────────────────────────────────────────────────────
\begin{document}

$if(title)$
\maketitle
$endif$

$if(toc)$
{\hypersetup{linkcolor=accent}
\setcounter{tocdepth}{$toc-depth$}
\tableofcontents
\vspace{1.5em}
{\color{rulecolor}\rule{\linewidth}{0.6pt}}
\vspace{1em}
}
$endif$

$body$

\end{document}
